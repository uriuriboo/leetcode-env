{
    "loop": {
        "prefix": "rep",
        "body": [
            "for i in 0..$1 {",
            "\t$0",
            "}"
        ],
        "description": "ループ"
    },
    "loop2": {
        "prefix": "rrep",
        "body": [
            "for i in 0..$1 {",
            "\tfor j in 0..$2 {",
            "\t\t$0",
            "\t}",
            "}"
        ],
        "description": "二重ループ"
    },
    "bitsearch": {
        "prefix": "pbit",
        "body": [
            "for bit in 0..1 << $1 {",
            "\tfor i in 0..$1 {",
            "\t\tif bit & (1 << i) != 0 {",
            "\t\t\t$0",
            "\t\t}",
            "\t}",
            "}"
        ],
        "description": "bit 全探索"
    },
    "binary_search": {
        "prefix": "bins",
        "body": [
            "// ok(left) = false、ok(right) = true になるように置き、ok(x) = true となる最小の x を求める",
            "let ok = |x: i64| -> bool { $2 };",
            "let (mut left, mut right): (i64, i64) = (-1, $1);",
            "while right - left > 1 {",
            "\tlet mid = left + (right - left) / 2;",
            "\tif ok(mid) {",
            "\t\tright = mid;",
            "\t} else {",
            "\t\tleft = mid;",
            "\t}",
            "}"
        ],
        "description": "めぐり式二分探索"
    },
    "grid_neighbors": {
        "prefix": "dirs",
        "body": [
            "for (dy, dx) in [(0, 1), (1, 0), (0, -1), (-1, 0)] {",
            "\tlet (ny, nx) = (y as i32 + dy, x as i32 + dx);",
            "\tif ny < 0 || nx < 0 || ny >= h as i32 || nx >= w as i32 {",
            "\t\tcontinue;",
            "\t}",
            "\tlet (ny, nx) = (ny as usize, nx as usize);",
            "\t$0",
            "}"
        ],
        "description": "グリッドの上下左右（範囲外は飛ばす）"
    },
    "tree_dfs": {
        "prefix": "tdfs",
        "body": [
            "fn dfs(node: &Option<Rc<RefCell<TreeNode>>>) -> i32 {",
            "\tmatch node {",
            "\t\tNone => 0,",
            "\t\tSome(n) => {",
            "\t\t\tlet n = n.borrow();",
            "\t\t\tlet (l, r) = (dfs(&n.left), dfs(&n.right));",
            "\t\t\t$0",
            "\t\t}",
            "\t}",
            "}"
        ],
        "description": "二分木の再帰（impl Solution の外か中に書く。use std::rc::Rc; と use std::cell::RefCell; が必要）"
    },
    "list_iter": {
        "prefix": "lliter",
        "body": [
            "let mut cur = &${1:head};",
            "while let Some(node) = cur {",
            "\t$0",
            "\tcur = &node.next;",
            "}"
        ],
        "description": "連結リストをたどる"
    },
    "list_from_vec": {
        "prefix": "llbuild",
        "body": [
            "let mut head = None;",
            "for &v in ${1:vals}.iter().rev() {",
            "\tlet mut node = Box::new(ListNode::new(v));",
            "\tnode.next = head;",
            "\thead = Some(node);",
            "}"
        ],
        "description": "Vec から連結リストを作る"
    },
    "debug_print": {
        "prefix": "dbg",
        "body": [
            "#[cfg(debug_assertions)]",
            "eprintln!(\"$1 = {:?}\", $1);"
        ],
        "description": "手元のデバッグビルドでだけ表示する（提出してもそのままでよい）"
    }
}
